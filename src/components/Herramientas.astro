---
import SVGHTML from "./SVGComponents/SVGHTML.astro";
import SVGCSS from "./SVGComponents/SVGCSS.astro";
import SVGJS from "./SVGComponents/SVGJS.astro";
import SVGReact from "./SVGComponents/SVGReact.astro";
import SVGAntDesign from "./SVGComponents/SVGAntDesign.astro";
import SVGRedux from "./SVGComponents/SVGRedux.astro";
import SVGNextJS from "./SVGComponents/SVGNextJS.astro";
import SVGBootstrap from "./SVGComponents/SVGBootstrap.astro";

import SVGNode from "./SVGComponents/SVGNode.astro";
import SVGExpress from "./SVGComponents/SVGExpress.astro";
import SVGPostres from "./SVGComponents/SVGPostres.astro";
import SVGMongoDB from "./SVGComponents/SVGMongoDB.astro";
import SVGJava from "./SVGComponents/SVGJava.astro";



import SVGGraphQL from "./SVGComponents/SVGGraphQL.astro";
import SVGGit from "./SVGComponents/SVGGit.astro";
import SVGGitHub from "./SVGComponents/SVGGitHub.astro";
import SVGNPM from "./SVGComponents/SVGNPM.astro";


import SVGYarn from "./SVGComponents/SVGYarn.astro";
import SVGTypeScript from "./SVGComponents/SVGTypeScript.astro";
import SVGDocker from "./SVGComponents/SVGDocker.astro"
import SVGLinux from "./SVGComponents/SVGLinux.astro"


import SVGSpring from "./SVGComponents/SVGSpring.astro";
import SVGAWS from "./SVGComponents/SVGAWS.astro"
import SVGAstro from "./SVGComponents/SVGAstro.astro";
import SVGTailwind from "./SVGComponents/SVGTailwind.astro";




---

<section>
    <h1 class="text-4xl text-yellow-300 mt-10 justify-self-center">
        Mis herramientas
    </h1>
    <div
        class="flex flex-wrap justify-evenly mt-5 content-center gap-x-5 gap-y-7 sm:ml-40 sm:mr-40"
    >
        <div class="border-amber-50 border-2 rounded-md">
            <h2 class="justify-self-center">FrontEnd</h2>
            <div class="flex">
                <SVGHTML/>
                <SVGCSS />
                <SVGJS />
                <SVGReact />
                <SVGAntDesign />
                <SVGRedux />
                <SVGNextJS />
                <SVGBootstrap />
            </div>
        </div>
        <div class="border-amber-50 border-2 rounded-md">
            <h2 class="justify-self-center">BackEnd</h2>
            <div class="flex">
                <SVGNode />
                <SVGExpress />
                <SVGPostres />
                <SVGMongoDB />
                <SVGGraphQL />
                <SVGJava />
               
            </div>
        </div>
        <div class="border-amber-50 border-2 rounded-md">
            <h2 class="justify-self-center">Otras Herramientas</h2>
            <div class="flex">
                <SVGGit />
                <SVGGitHub />
                <SVGNPM />
                <SVGYarn />
                <SVGTypeScript />
                <SVGDocker />
                <SVGLinux />
               
    
               
            </div>
        </div>
        <div class="border-amber-50 border-2 rounded-md">
            <h2 class="justify-self-center">Actualmente aprendiendo</h2>
            <div class="flex">
                <SVGSpring />
                <SVGAWS />
                <SVGAstro/>
                <SVGTailwind />
            </div>
        </div>
    </div>
</section>
