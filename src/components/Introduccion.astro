---
import Button from "./Buttons/Button.astro";
import SVGLinkedIn from "./SVGComponents/SVGLinkedIn.astro";
import SVGGithub from "./SVGComponents/SVGGithub.astro";
---

<section id="introduccion" class="my-40 md:grid grid-cols-2">
    <img
        class="rounded-full border-4 border-solid border-indigo-700 w-3xs h-14s justify-self-center xl:ml-40"
        src="https://avatars.githubusercontent.com/u/79713968?v=4"
        alt="Foto de Jose Daniel"
    />
    <div class="text-center max-md:mx-8 md:text-left md:mr-25 xl:mr-70 2xl:mr-100">
        <h1 class="text-5xl">
            Hola, me llamo <br />
            <span class="text-indigo-600">Jose Daniel Bustamante Arango</span>
        </h1>
        <p class="text-2xl  ">
            soy <span class="text-indigo-700">programador FullStack</span> con 3 años
            de experiencia.
        </p>
        <div class="mt-3">
            <ul class="flex gap-x-2.5 max-md:justify-center">
                <li>
                    <Button
                        nombre="LinkedIn"
                        SVG="2"
                        link="https://www.linkedin.com/in/jos%C3%A9-daniel-bustamante-arango-008773212/"
                    >
                        <SVGLinkedIn />
                    </Button>
                </li>

                <li>
                    <Button
                        nombre="GitHub"
                        SVG="2"
                        link="https://github.com/JoseDaniel959"
                    >
                        <SVGGithub />
                    </Button>
                </li>
            </ul>
        </div>
    </div>
</section>
