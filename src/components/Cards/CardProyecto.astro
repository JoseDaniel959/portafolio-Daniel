---
import Button from "../Buttons/Button.astro";
import SVGGithub from "../SVGComponents/SVGGithub.astro";

const { imagenSrc, titulo, descripcion, linkRepositorio, altText } =
    Astro.props;
---

<article
    class="rounded-xl mt-5 w-sm sm:w-2xl md:w-3xl border-b-gray-200 border-2 justify-items-center"
>
    <div class="sm:flex sm:h-60 justify-between">
        <img
            class="sm:rounded-l-xl rounded-t-xl md:w-auto w-96"
            src={imagenSrc}
            alt={altText}
        />
        <div class="inline-block align-baseline">
            <h1 class="text-2xl font-semibold justify-self-center">
                {titulo}
            </h1>
            <p class="ml-9">{descripcion}</p>
            <div class="ml-9 mt-1.5">
                <Button nombre="Código" SVG="2" link={linkRepositorio}>
                    <SVGGithub />
                </Button>
            </div>
        </div>
    </div>
</article>
