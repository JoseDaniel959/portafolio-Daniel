---
const {cargo,compañia,fechaInicioYSalida, actividadesRealizadas} = Astro.props
---


<div class="mt-5 xl:pl-60 xl:pr-60 sm:pl-30 sm:pr-30 pl-5 pr-5 w-5/6">
    <h2 class="text-2xl text-amber-200 bol">
        {cargo}
    </h2>
    <h2 class="text-2xl">{compañia}</h2>
    <p>{fechaInicioYSalida}</p>
    <p>
        {actividadesRealizadas}
    </p>
</div>
