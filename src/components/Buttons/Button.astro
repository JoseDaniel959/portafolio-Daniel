---
const { nombre, link } = Astro.props;
---

<a href={link}>
    <div
        class="flex flex-row bg-black border-indigo-700 border-2 rounded-xl justify-center w-30 transition hover:scale-110 h-8"
    >
        <div class="pb-0.5">
            <slot />
        </div>
        <div class="pt-0.5 pl-0.5">{nombre}</div>
    </div>
</a>
