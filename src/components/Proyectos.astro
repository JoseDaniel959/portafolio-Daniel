---
import imagenPruebaTecnica from "../assets/pruebaTecnica.png";
import imagenJuegoDeTrivia from "../assets/JuegoTriviaSpring.png";
import imagenToDoAppFront from "../assets/toDoAppImage.png";
import imagenSpringWebFlux from "../assets/SpringWebFlux.png";

import CardProyecto from "./Cards/CardProyecto.astro";

type Proyecto = {
    titulo: string;
    descripcion: string;
    linkRepositorio: string;
    imagenSrc: string;
    altText: string;
};

const arregloProyectos: Proyecto[] = [
    {
        titulo: "To Do App",
        descripcion: `To do App realizada Next.js, React, BootStrap.
                    API realizada con Express.js, Prisma ORM y Postgres.
                    Contiene operaciones CRUD básicas sobre tareas. Construída
                    con arquitectura hexagonal.`,
        linkRepositorio:
            "https://github.com/JoseDaniel959/Todo-App/tree/master",
        imagenSrc: imagenToDoAppFront.src,
        altText: "Pantallazo de To Do App",
    },
    {
        titulo: "Spring WebFlux API",
        descripcion: `Prueba técnica de Accenture para rol de ingeninero backend.
                      Está reailzada con Java 17 ,Java Spring WebFlux,
                      Postgres, Docker y Terraform `,
        linkRepositorio:
            "https://github.com/JoseDaniel959/Todo-App/tree/master",
        imagenSrc: imagenSpringWebFlux.src,
        altText: "Pantallazo prueba técnica Spring WebFlux API",
    },
    {
        titulo: "Trivia Game Spring",
        descripcion: `Juego de consola sobre preguntas de cultura general,implementado 
                      en Spring. Es prueba técnica inspirado por EPAM.`,
        linkRepositorio:
            "https://github.com/JoseDaniel959/knowledge-checker-task",
        imagenSrc: imagenJuegoDeTrivia.src,
        altText: "Pantallazo Trivia Game Spring",
    },
    {
        titulo: "Prueba Técnica",
        descripcion: `Prueba técnica para desarrollador FrontEnd. Realizada con
                    HTML,CSS y Bootstrap 5. Contiene responsive design.`,
        linkRepositorio: "https://github.com/JoseDaniel959/Prueba-Tecnica",
        imagenSrc: imagenPruebaTecnica.src,
        altText: "Pantallazo de Prueba Técnica",
    },
];
---

<section id="Projectos" class="justify-items-center mt-10">
    <h1 class="text-4xl text-yellow-300">Mis proyectos</h1>
    {
        arregloProyectos.map(
            ({ titulo, descripcion, linkRepositorio, imagenSrc, altText }) => {
                return (
                    <CardProyecto
                        imagenSrc={imagenSrc}
                        titulo={titulo}
                        descripcion={descripcion}
                        linkRepositorio={linkRepositorio}
                        altText={altText}
                    />
                );
            },
        )
    }
</section>
